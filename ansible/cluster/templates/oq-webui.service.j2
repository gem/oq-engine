[Unit]
Description=The OpenQuake Engine WebUI
Documentation=https://github.com/gem/oq-engine/

[Service]
User=openquake
Group=openquake
Environment=
WorkingDirectory={{ webuidir_services }}
# Nginx (or another webserver) must serve the static files from STATIC_ROOT
ExecStart=/opt/openquake/venv/bin/gunicorn --bind 127.0.0.1:8800 --workers 4 --timeout 1200 wsgi:application
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
