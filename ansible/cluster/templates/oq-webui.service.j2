[Unit]
Description=The OpenQuake Engine WebUI
Documentation=https://github.com/gem/oq-engine/
After=network.target oq-dbserver.service

[Service]
User=openquake
Group=openquake
Environment=
WorkingDirectory={{ webuidir_services }}
# Nginx (or another webserver) must serve the static files from STATIC_ROOT
ExecStart=/opt/openquake/bin/python3 -m gunicorn openquake.server.wsgi:application --bind {{ server_host }}:8800 --workers 1 --worker-class gthread --threads 16 --timeout 1200
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
