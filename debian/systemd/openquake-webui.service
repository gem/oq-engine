[Unit]
Description=The OpenQuake Engine WebUI
Documentation=https://github.com/gem/oq-engine/
After=network.target

[Service]
User=openquake
Group=openquake
#in WorkingDirectory use the folder of the sources from what are installed the engine
WorkingDirectory=/usr/share/openquake/engine
#in ExecStart use the folder of venv
# Nginx (or another webserver) must serve the static files from STATIC_ROOT
ExecStart=/opt/openquake/bin/python3 -m gunicorn openquake.server.wsgi:application --bind 127.0.0.1:8800 --workers 1 --worker-class gthread --threads 16 --timeout 1200
Type=exec
Restart=always
RestartSec=30
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
