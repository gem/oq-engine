FROM python:3.12.6-slim AS compile-image
LABEL maintainer="GEM Foundation <devops@openquake.org>" \
       vendor="GEM Foundation"
RUN useradd -m -u 1000 -U -s /bin/bash openquake
RUN apt-get update &&  apt-get install -y --no-install-recommends build-essential gcc git libcap-dev
ARG oq_branch=master
# Clone the repository and install the engine for the container user.
WORKDIR /usr/src
RUN git clone https://github.com/gem/oq-engine.git --depth=1 --branch $oq_branch && \
    chown -R openquake:openquake oq-engine
USER openquake
ENV HOME=/home/openquake
WORKDIR ${HOME}
RUN python3 /usr/src/oq-engine/install.py --version "$oq_branch" user
#
FROM python:3.12.6-slim AS build-image
RUN useradd -m -u 1000 -U -s /bin/bash openquake
COPY --from=compile-image --chown=openquake:openquake \
    /home/openquake/openquake/ /home/openquake/openquake/
ENV LANG=en_US.UTF-8
USER openquake
ENV HOME=/home/openquake
WORKDIR ${HOME}
ENV VIRTUAL_ENV=/home/openquake/openquake
ENV PATH="$VIRTUAL_ENV/bin:$PATH"
#
ADD scripts/oq-start.sh ${HOME}
RUN mkdir oqdata
EXPOSE 8800
STOPSIGNAL SIGINT
ENTRYPOINT ["./oq-start.sh"]
CMD ["oq", "webui", "start", "0.0.0.0:8800", "-s"]
