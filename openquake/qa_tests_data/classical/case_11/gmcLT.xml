<?xml version="1.0" encoding="UTF-8"?>
<nrml xmlns:gml="http://www.opengis.net/gml" xmlns="http://openquake.org/xmlns/nrml/0.5">
<logicTree logicTreeID='lt1'>
  <logicTreeBranchSet uncertaintyType="gmpeModel" branchSetID="bs1"
                      applyToTectonicRegionType="Active Shallow Crust">

    <!-- Low: no shift applied (ergodic backbone) -->
    <logicTreeBranch branchID="grid_adjusted_low">
      <uncertaintyModel>
        [GridAdjustedGMPE]
        gmpe_name = "AkkarEtAlRjb2014"
        grid_hdf5_file = "grid_adjustments.hdf5"
        epsilons.dL2L = 0.0
        epsilons.dS2S = 0.0
        epsilons.att_per_km = 0.0
      </uncertaintyModel>
      <uncertaintyWeight>0.17</uncertaintyWeight>
    </logicTreeBranch>

    <!-- Central: mean shifted by the fitted adjustment -->
    <logicTreeBranch branchID="grid_adjusted_central">
      <uncertaintyModel>
        [GridAdjustedGMPE]
        gmpe_name = "AkkarEtAlRjb2014"
        grid_hdf5_file = "grid_adjustments.hdf5"
        epsilons.dL2L = 1.0
        epsilons.dS2S = 1.0
        epsilons.att_per_km = 1.0
      </uncertaintyModel>
      <uncertaintyWeight>0.66</uncertaintyWeight>
    </logicTreeBranch>

    <!-- High: mean shifted by twice the fitted adjustment -->
    <logicTreeBranch branchID="grid_adjusted_high">
      <uncertaintyModel>
        [GridAdjustedGMPE]
        gmpe_name = "AkkarEtAlRjb2014"
        grid_hdf5_file = "grid_adjustments.hdf5"
        epsilons.dL2L = 2.0
        epsilons.dS2S = 2.0
        epsilons.att_per_km = 2.0
      </uncertaintyModel>
      <uncertaintyWeight>0.17</uncertaintyWeight>
    </logicTreeBranch>

  </logicTreeBranchSet>
</logicTree>
</nrml>
