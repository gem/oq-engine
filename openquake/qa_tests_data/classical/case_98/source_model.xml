<?xml version="1.0" encoding="utf-8"?>
<nrml
xmlns="http://openquake.org/xmlns/nrml/0.4"
xmlns:gml="http://www.opengis.net/gml"
>
  <sourceModel
      name="source_model"
      >
    <pointSource
        id="1"
        name="point source"
        tectonicRegion="active shallow crust"
        >
      <pointGeometry>
        <gml:Point>
          <gml:pos>
            0.0 0.0
          </gml:pos>
        </gml:Point>
        <upperSeismoDepth>0.0</upperSeismoDepth>
        <lowerSeismoDepth>10.0</lowerSeismoDepth>
      </pointGeometry>
      <magScaleRel>WC1994</magScaleRel>
      <ruptAspectRatio>1.0</ruptAspectRatio>
      <incrementalMFD binWidth="1.0" minMag="5.0">
        <occurRates>1.0</occurRates>
      </incrementalMFD>
      <nodalPlaneDist>
        <nodalPlane strike="0" dip="90" rake="0" probability="1.0"/>
      </nodalPlaneDist>
      <hypoDepthDist>
        <hypoDepth depth="5" probability="1.0"/>
      </hypoDepthDist>
    </pointSource>
  </sourceModel>
</nrml>
